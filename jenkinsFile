pipeline {
    agent any

    triggers {
        cron('0 0 * * 0')
    }

    environment {
        PYTHONUNBUFFERED = '1'
        PYTHONPATH = '.'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Set Up Python Environment') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install --upgrade pip
                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    fi
                '''
            }
        }

        stage('Train Model') {
            steps {
                sh '''
                    . .venv/bin/activate
                    python ml/train.py
                '''
            }
        }

        stage('Evaluate Performance Gate') {
            steps {
                sh '''
                    . .venv/bin/activate
                    python ml/evaluate.py
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    . .venv/bin/activate
                    pytest -v tests/test_api.py
                '''
            }
        }

        stage('Archive Model Artifact') {
            steps {
                // Archives the newly generated model inside the Jenkins build record
                archiveArtifacts artifacts: 'models/*.pkl', fingerprint: true, allowEmptyArchive: false
            }
        }

        stage('Build & Test Docker Container') {
            steps {
                sh '''
                    # Clean up old container if running
                    docker rm -f api-test-container 2>/dev/null || true

                    # Build image from local Dockerfile
                    docker build -t yt-sentiment-app:latest .

                    # Run container in background
                    docker run -d -p 8000:8000 --name api-test-container yt-sentiment-app:latest

                    # Verify health endpoint (retries for 30s)
                    timeout 30 bash -c 'until curl -s -f http://localhost:8000/health; do sleep 2; done' || {
                        echo "Health check failed. Container output:"
                        docker logs api-test-container
                        docker rm -f api-test-container
                        exit 1
                    }

                    echo "API container verified successfully."
                '''
            }
        }
    }

    post {
        always {

            sh 'docker rm -f api-test-container 2>/dev/null || true'
        }
    }
